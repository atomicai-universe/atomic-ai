# Atomic AI — example environment configuration (Req 18.2).
#
# Copy this file to `.env` and replace every placeholder with a real value.
# This file MUST contain only placeholders — never commit real secrets.
# The backend fails fast at startup naming any missing required variable
# (Req 18.3) and never logs secret values (Req 18.4).

# =============================================================================
# REQUIRED — backend refuses to start if any of these is missing
# =============================================================================

# PostgreSQL async DSN used by SQLAlchemy (asyncpg driver).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://atomic:CHANGE_ME@postgres:5432/atomic_ai

# Redis connection URL used for caching, sessions, and the ARQ job queue.
# Format: redis://<host>:<port>/<db>
REDIS_URL=redis://redis:6379/0

# Symmetric key for the Encryption_Service. Generate a fresh key; never reuse
# this placeholder. Example (Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Google OAuth application credentials.
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# GitHub OAuth application credentials.
GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# =============================================================================
# OPTIONAL — sensible defaults applied in backend/app/config.py if unset
# =============================================================================

# Comma-separated list (or JSON array) of allowlisted CORS origins.
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# Maximum accepted request body size in bytes (requests above return 413).
MAX_BODY_SIZE_BYTES=1048576

# Allowed authentication requests per client per minute (above returns 429).
AUTH_RATE_LIMIT_PER_MINUTE=10

# Deployment environment name: development | staging | production
ENVIRONMENT=development

# =============================================================================
# COMPOSE-ONLY — consumed by docker-compose.yml to provision the datastores
# =============================================================================

# Credentials for the bundled PostgreSQL container. Keep these consistent with
# the user/password/db embedded in DATABASE_URL above.
POSTGRES_USER=atomic
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=atomic_ai

# Base URL the frontend uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# =============================================================================
# STRANDS AGENT MODEL PROVIDER — Amazon Bedrock (Strands default)
# =============================================================================
# The Strands Agents SDK uses Amazon Bedrock by default. Provide AWS credentials
# with permission to invoke Bedrock models (bedrock:InvokeModel*). Credentials
# are read from the standard AWS chain; the values below are passed into the
# backend container. Leave keys blank to use a mounted profile or instance role.

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
# Only needed for temporary/STS credentials:
AWS_SESSION_TOKEN=
# Bedrock model id the agent uses (must be enabled in your Bedrock account/region):
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
# Use streaming Converse. Disabled by default: some Bedrock models (e.g. Amazon
# Nova) emit invalid tool-use sequences when streaming.
BEDROCK_STREAMING=false

# Amazon SNS SMS reply-approval notifications. SNS reuses the SAME AWS
# credentials + AWS_REGION as Bedrock above (no separate key). When a reply
# awaits approval, the user's stored phone number is texted. Sending is
# best-effort and never blocks approval creation. Requires SNS SMS to be
# enabled/out-of-sandbox in your AWS account for the destination countries.
SNS_ENABLED=true
# Transactional (reliable, used for alerts) or Promotional (cheaper, filterable).
SNS_SMS_TYPE=Transactional
# Optional alphanumeric Sender ID where the destination supports it; blank = unset.
SNS_SMS_SENDER_ID=
# Per-user monthly SMS spend cap (USD); 0 disables. Guards runaway cost.
SNS_MONTHLY_USER_SPEND_CAP_USD=5.0

# Agent run cost-control — HARD caps on a SINGLE agent run. Root-cause fix for
# multi-million-token runs: without these, one 'process the inbox' run kept
# every email body + draft in context and re-sent them each turn (quadratic
# token growth). AGENT_MAX_TURNS / AGENT_MAX_TOTAL_TOKENS are hard budgets
# (run stops gracefully when hit). AGENT_MAX_OUTPUT_TOKENS caps each response.
# AGENT_CONVERSATION_WINDOW bounds how many messages stay in context.
AGENT_MAX_TURNS=12
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_CONVERSATION_WINDOW=24
# Per-integration poll lock TTL (seconds). Stops overlapping poll sweeps from
# processing the same inbox at once (prevents duplicate runs). See TOKEN-BLOWUP.md.
POLL_LOCK_TTL_SECONDS=300
# Batch size: max Gmail messages one agent run may process (overflow waits
# for the next cycle). Bounds cost per run. See TOKEN-BLOWUP.md.
GMAIL_MAX_IDS_PER_RUN=5

# Public HTTPS base URL used ONLY to build INBOUND webhook URLs (provider push
# and Gmail Pub/Sub callbacks). Split from OAUTH_REDIRECT_BASE_URL so a local
# dev box can expose webhooks via a public tunnel (e.g. ngrok) WITHOUT changing
# the OAuth redirect_uri (which must stay the host registered with your OAuth
# client, usually http://localhost:8000). Leave empty to fall back to
# OAUTH_REDIRECT_BASE_URL (single-host deployments are unchanged).
# NOTE: ngrok free URLs change on every restart — update this value AND the
# Pub/Sub push subscription endpoint, then reconnect Gmail, when it changes.
WEBHOOK_PUBLIC_BASE_URL=

# Gmail push notifications (watch + Pub/Sub). Full topic name:
# projects/<project>/topics/<topic>. Leave empty to poll instead of push.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications

# How often (minutes) the worker polls poll-based integrations, incl. Gmail
# when push is not configured. A full Bedrock agent run is only enqueued when a
# cheap unread pre-check finds genuinely NEW mail, so a higher value cuts poll
# sweeps without dropping automation. Range 1-60. Default 10 (Bedrock cost-control).
GMAIL_POLL_MINUTES=10
