# Multi-stage build for the Atomic AI Next.js 16 frontend.
#
# The frontend project itself is scaffolded in task 17.1. This Dockerfile
# establishes the pinned Node base and the build/runtime split now so Compose
# can reference it; it installs dependencies, builds the Next.js 16 app, and
# serves the production output.

# ---- Stage 1: dependencies ----------------------------------------------------
FROM node:22-bookworm-slim AS deps
WORKDIR /app

# Install dependencies from the lockfile when present for reproducible builds.
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

# ---- Stage 2: builder ---------------------------------------------------------
FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
# Next.js 16 production build.
RUN npm run build

# ---- Stage 3: runtime ---------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

# Copy the built application and its production dependencies.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

# Run as the built-in unprivileged node user.
USER node

EXPOSE 3000

CMD ["npm", "run", "start"]
